.env
.terraform.lock.hcl
**/lambda/*
# Local .terraform directories (contains provider binaries and plugins)
**/.terraform/*

# .tfstate files (contains cleartext secrets and infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (likely to contain sensitive passwords/API keys)
*.tfvars
*.tfvars.json

# Ignore override files (used for local modifications)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan outputs (can be large and contain temporary execution graphs)
*tfplan*
